{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alpine Owner Admin",
  "version": "1.0.0",
  "identifier": "com.alpine.restaurant.management",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{"label":"main","title":"Alpine · Owner & Admin","width":1200,"height":820,"minWidth":640,"minHeight":520,"center":true,"backgroundColor":"#f4f6fa","theme":"Light","dragDropEnabled":false}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": ["launcher"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Business",
    "shortDescription": "Alpine Owner and Admin workspace",
    "longDescription": "The complete Alpine Restaurant management panel for Owner and Admin accounts, with a consistent ERP interface, cloud and server-PC connections, printing and report exports.",
    "icon": ["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {"type":"offlineInstaller","silent":true},
      "nsis": {"installMode":"currentUser","languages":["English"],"displayLanguageSelector":false,"startMenuFolder":"Alpine Restaurant"}
    }
  }
}
