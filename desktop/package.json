{
  "name": "alpine-counter-desktop",
  "version": "1.0.26",
  "private": true,
  "description": "Offline-first Alpine cashier for Windows 10/11 x64",
  "author": "Alpine Restaurant",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.cjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "postinstall": "node scripts/share-core.cjs",
    "publish": "node scripts/publish.cjs",
    "smoke": "electron scripts/smoke.cjs",
    "smoke:main": "electron scripts/main-smoke.cjs",
    "smoke:windows": "electron scripts/multi-window-smoke.cjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "esbuild": "0.27.3",
    "typescript": "5.9.3",
    "@types/node": "24.10.1",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7"
  },
  "build": {
    "appId": "com.alpine.simple.counter",
    "productName": "Alpine Cash Counter",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Alpine-Cash-Counter-${version}-Windows-x64.${ext}",
      "icon": "../public/alpine-brand.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "Alpine Cash Counter"
    },
    "asarUnpack": [
      "dist/raw-print.exe"
    ]
  }
}
