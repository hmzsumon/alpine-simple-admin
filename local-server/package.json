{
  "name": "alpine-local-server",
  "version": "1.1.14",
  "private": true,
  "description": "SQLite LAN server for the existing Alpine Counter, Waiter and Admin apps",
  "author": "Alpine Restaurant",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.cjs",
    "dist": "node scripts/package.cjs",
    "start": "../desktop/node_modules/.bin/electron .",
    "test:network": "node tests/network.cjs",
    "test:integration": "node tests/integration.cjs --manager",
    "test:sqlite": "node tests/sqlite.integration.cjs --manager",
    "test:startup": "node --test tests/startup.test.cjs"
  },
  "build": {
    "appId": "com.alpine.simple.localserver",
    "productName": "Alpine Local Server",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime/api",
        "to": "api"
      },
      {
        "from": "runtime/admin",
        "to": "admin"
      },
      {
        "from": "runtime/api/node_modules",
        "to": "api/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "runtime/admin/node_modules",
        "to": "admin/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Alpine-Local-Server-${version}-Windows-x64.${ext}",
      "icon": "../public/app-icons/server/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "Alpine Local Server"
    },
    "asarUnpack": [
      "dist/server-process-host.exe"
    ],
    "afterAllArtifactBuild": "scripts/archive-artifacts.cjs"
  }
}
